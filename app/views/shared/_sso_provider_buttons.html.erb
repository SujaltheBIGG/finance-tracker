<% if providers.any? %>
  <div class="mt-6 space-y-3">
    <% providers.each do |provider| %>
      <% provider_id = provider[:id].to_s %>
      <% provider_name = provider[:name].to_s %>
      <% is_google = provider_id == "google" || provider[:strategy].to_s == "google_oauth2" %>
      <% default_label = is_google ? t("sessions.new.google_auth_connect") : t("sessions.new.#{provider_id}", default: provider_name.titleize) %>
      <% button_label = is_google && local_assigns[:google_label].present? ? local_assigns[:google_label] : provider[:label].presence || default_label %>

      <%= render DS::Button.new(
            href: "/auth/#{provider_name}",
            method: :post,
            variant: :outline,
            size: :md,
            full_width: true,
            icon: is_google ? "google-icon" : provider[:icon].presence,
            icon_custom: is_google,
            text: button_label,
            class: "gap-2",
            form: { data: { turbo: false } }
          ) %>
    <% end %>
  </div>
<% end %>
